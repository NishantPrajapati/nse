# NSE Strategy Alerts - Environment Configuration Template
# Copy this file to .env and fill in your actual values

# Application Settings
APP_NAME=NSE Strategy Alerts
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# Database Configuration
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/nse_alerts

# Angel One API Configuration
ANGEL_ONE_API_KEY=your_api_key_here
ANGEL_ONE_CLIENT_ID=your_client_id_here
ANGEL_ONE_PASSWORD=your_password_here
ANGEL_ONE_TOTP_SECRET=your_totp_secret_here

# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# API Security
API_KEY=your_secure_api_key_here
ADMIN_API_KEY=your_secure_admin_api_key_here

# Strategy Scheduling (24-hour format HH:MM)
VCP_SCAN_TIME=18:30
RB_DAILY_SCAN_TIME=18:30
MONTHLY_SCAN_TIME=18:30
MULTIBAGGER_SCAN_TIME=18:30
FUNDAMENTAL_SCAN_TIME=19:00

# Data Ingestion Schedule
DAILY_INGEST_TIME=16:00
WEEKLY_INGEST_TIME=16:30
MONTHLY_INGEST_TIME=17:00

# Market Data Settings
MIN_PRICE=10.0
MAX_PRICE=10000.0
MIN_VOLUME=1000

# Scheduler Settings
ENABLE_SCHEDULER=true
SCHEDULER_TIMEZONE=Asia/Kolkata

# Fundamentals Provider
FUNDAMENTALS_PROVIDER=mock
# Options: mock, screener, tickertape

# Cache Settings
INSTRUMENT_CACHE_TTL_HOURS=24
DATA_READY_THRESHOLD_HOURS=2

# Alert Settings
ENABLE_TELEGRAM_ALERTS=true
ALERT_BATCH_SIZE=10
ALERT_DELAY_SECONDS=2

# Performance Settings
MAX_CONCURRENT_REQUESTS=10
REQUEST_TIMEOUT_SECONDS=30
